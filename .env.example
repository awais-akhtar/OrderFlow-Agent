# Core tools and operator screens run without credentials. Customer chat requires a streaming model.
ORDERFLOW_DB_PATH=data/orderflow.db
ORDERFLOW_HOST=127.0.0.1
ORDERFLOW_PORT=8080

# Runtime: disabled, openai, kernelloom, openagent, or huggingface.
# KernelLoom, OpenAI, and compatible Hugging Face endpoints support customer streaming.
# The same values can be entered for one server session on the Settings page.
GENAI_PROVIDER=disabled
GENAI_PROVIDER_BASE_URL=

# OpenAI. Set an explicit model id; OrderFlow-Agent does not guess one.
OPENAI_API_KEY=
GENAI_RESPONSE_MODEL=
GENAI_TRANSCRIPTION_MODEL=
GENAI_SPEECH_MODEL=
GENAI_EMBEDDING_MODEL=
GENAI_VOICE=alloy

# KernelLoom can use its loopback HTTP server or the installed PyPI package.
KERNELLOOM_API_KEY=
KERNELLOOM_TRANSPORT=python
KERNELLOOM_CHAT_MODEL_PATH=
KERNELLOOM_EMBEDDING_MODEL_PATH=
KERNELLOOM_BACKEND=openvino
KERNELLOOM_DEVICE=CPU
KERNELLOOM_CPU_PROFILE=latency
KERNELLOOM_RESERVE_CORES=1
KERNELLOOM_DATA_DIR=data/kernelloom

# OpenAgent HTTP adapter. A token is needed only when its auth gate is enabled.
OPENAGENT_API_TOKEN=
GENAI_OPENAGENT_PROVIDER=auto
GENAI_OPENAGENT_PROJECT=orderflow-agent
GENAI_OPENAGENT_ALLOW_EXTERNAL=0

# Hosted Hugging Face Inference Endpoint. The base URL must include /v1.
HF_TOKEN=
